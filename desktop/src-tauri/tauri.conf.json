{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kontor",
  "version": "0.23.9",
  "identifier": "at.kontor.desktop",
  "build": {
    "frontendDist": "../../ui-preview"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kontor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "maximized": true,
        "resizable": true,
        "backgroundColor": "#EFF2F6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self'; connect-src ipc: http://ipc.localhost; worker-src blob:; frame-src http://127.0.0.1:* http://localhost:*",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/bilder/**"]
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Kontor",
    "category": "Business",
    "shortDescription": "Warenwirtschaft & Kasse",
    "longDescription": "Kontor – On-Premise-Warenwirtschaft und Kassensystem für Mode, Sport, Outdoor und Lifestyle.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "languages": [
          "German"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "de-DE"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDQTBFQjk4QjA3RUUxMkIKUldRcjRYNndtT3VnckcweTVzK1Rrbmp5TkRqZEkwV1dCM3g4MWpZOVRRSkhUVXhYQ1U3dUZaaWEK",
      "endpoints": [
        "https://github.com/Jecuro1/advarics/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
