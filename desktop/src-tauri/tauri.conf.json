{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kontor",
  "version": "0.2.0",
  "identifier": "at.kontor.desktop",
  "build": {
    "frontendDist": "../../ui-preview"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kontor",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "maximized": true,
        "resizable": true,
        "backgroundColor": "#08080A"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Kontor",
    "category": "Business",
    "shortDescription": "Warenwirtschaft & Kasse",
    "longDescription": "Kontor – On-Premise-Warenwirtschaft und Kassensystem für Mode, Sport, Outdoor und Lifestyle.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "languages": ["German"],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "de-DE"
      }
    }
  }
}
